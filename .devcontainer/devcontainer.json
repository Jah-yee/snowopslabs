// GitHub Codespaces and VS Code Dev Containers: a lab that runs in the browser.
// Guide: docs/getting-started/codespaces.md
{
  "name": "SnowOps Labs",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.9-ubuntu24.04",
  // Docker runs inside the codespace, so the lab's k3d cluster lives there too.
  // Go and Node build labctl from source when the codespace is on main.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
    "ghcr.io/devcontainers/features/go:1.4.0": {},
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "22"
    }
  },
  // A 4-core codespace has 16 GB: the platform, one scenario and the heavier
  // scenarios (Kafka, mesh, GitOps) all fit, and init finishes faster.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  // setup.sh puts labctl in ~/.local/bin and init puts kubectl, helm and k3d there.
  // GOTOOLCHAIN=auto fetches the Go toolchain src/go.mod pins.
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}",
    "GOTOOLCHAIN": "auto"
  },
  "postCreateCommand": "sh .devcontainer/setup.sh",
  "portsAttributes": {
    "3939": {
      "label": "labctl dashboard",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "Grafana (kubectl port-forward)",
      "onAutoForward": "openBrowser"
    },
    // The ingress routes by *.localhost hostname, which a forwarded URL cannot carry.
    "80": {
      "label": "lab ingress",
      "onAutoForward": "silent"
    },
    "443": {
      "label": "lab ingress (TLS)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/getting-started/codespaces.md"]
    },
    "vscode": {
      "extensions": ["ms-kubernetes-tools.vscode-kubernetes-tools"]
    }
  }
}
