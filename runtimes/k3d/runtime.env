# k3d runtime-specific defaults. The ingress class follows INGRESS_PROVIDER
# (internal/config).
# Loaded by labctl and platform scripts to resolve runtime-specific values.
# Other runtimes (kind, incluster) have their own runtime.env with different values.

STORAGE_CLASS=local-path
# DOMAIN_SUFFIX defaults to <CLUSTER_NAME>.localhost (internal/config).
REGISTRY_TYPE=k3d-import
