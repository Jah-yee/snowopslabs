# Root environment configuration
# These are global defaults shared across all apps and the runtime.
# Per-app settings should go in apps/<app-name>/app.env instead.
#
# Keep comments on their own lines (not trailing a VALUE). This file is both
# `include`d by the Makefile and read by labctl; a trailing "# comment" leaves
# whitespace on the value under Make (PROFILE would become "k3d   "), which
# breaks cluster names, ports and profile lookups.
#
# For labctl, an environment variable wins over this file, and this file over
# runtimes/<PROFILE>/runtime.env: docs/reference/cli/index.md#configuration.

# === Cluster/Runtime Configuration ===
# PROFILE: runtime profile - k3d | kind | incluster
PROFILE=k3d
# CLUSTER_NAME: name of the local cluster, unique on this machine. Default:
# snowops for k3d, snowops-kind for kind. Lab URLs include it, e.g.
# http://grafana.snowops.localhost.
# CLUSTER_NAME=snowops
# LAB_CPUS / LAB_MEMORY: size (CPUs, GB) labctl starts colima at on macOS.
# 2 / 4 is the minimum and runs the baseline plus the lighter scenarios; raise
# them for heavier ones. A running VM is never resized for you.
LAB_CPUS=2
LAB_MEMORY=4
# AGENTS: agent nodes the k3d cluster starts with. Scenarios that need more
# (the node-drain and upgrade drills need 2) add them when they start.
# AGENTS=1
# HTTP_PORT / HTTPS_PORT: host ports to expose ingress traffic. When one is
# taken, the lab uses a free one and every URL follows it.
HTTP_PORT=80
HTTPS_PORT=443
# DOMAIN_SUFFIX: what lab hostnames end in. Default for k3d and kind:
# <CLUSTER_NAME>.localhost, which every browser resolves to this machine, so no
# hosts-file entries are needed. A lab keeps the suffix it was built with.
# DOMAIN_SUFFIX=snowops.localhost

# === Global Defaults ===
# These can be overridden per-app by setting them in apps/<app-name>/app.env.
# APP_NAME=go-api
# HELM_RELEASE_NAME=go-api
# HELM_VALUES=values-dev.yaml

# === Platform Provider Selection ===
# Each category can have multiple providers. Change the value and re-run
# platform-up.
# INGRESS_PROVIDER: traefik | nginx
INGRESS_PROVIDER=traefik
# METRICS_PROVIDER: prometheus | victoria-metrics
METRICS_PROVIDER=prometheus
# MONITORING_NAMESPACE: namespace for metrics, Grafana, Loki, and Tempo
MONITORING_NAMESPACE=monitoring
# LOGGING_PROVIDER=loki            # loki | elasticsearch (Phase 2)
# TRACING_PROVIDER=tempo           # tempo | jaeger (Phase 2)
# GITOPS_PROVIDER=argocd           # argocd | flux (Phase 3)
# CHAOS_PROVIDER=chaos-mesh        # chaos-mesh | litmus (Phase 5)
# POLICY_PROVIDER=kyverno          # kyverno | opa-gatekeeper (Phase 4)
# SECRETS_PROVIDER=sealed-secrets  # sealed-secrets | external-secrets (Phase 4)

# Per-runtime overrides live in runtimes/<profile>/runtime.env, which the
# executor layers on top of these defaults. Example: add
# "KUBECONFIG_CONTEXT=my-cluster" to runtimes/kind/runtime.env.
