{
  "vars": {
    "DomainSuffix": "snowops-e2e.localhost",
    "IngressClass": "traefik",
    "IngressURLSuffix": "snowops-e2e.localhost",
    "LokiRetentionPeriod": "168h",
    "MonitoringNamespace": "monitoring",
    "SinceActivation": "1m",
    "WorkloadMetric": "http_server_request_duration_seconds",
    "WorkloadName": "go-api",
    "WorkloadNamespace": "go-api",
    "WorkloadPort": "8080",
    "WorkloadService": "go-api.go-api.svc.cluster.local"
  },
  "prometheusURL": "http://prometheus.snowops-e2e.localhost",
  "kubectl": {
    "get deployment/env-consumer --namespace go-api -o jsonpath={.status.readyReplicas}": {
      "out": "1"
    },
    "get deployment/external-secrets --namespace external-secrets -o jsonpath={.status.readyReplicas}": {
      "out": "1"
    },
    "get deployment/secret-consumer --namespace go-api -o jsonpath={.status.readyReplicas}": {
      "out": "1"
    },
    "get externalsecret/go-api-secret --namespace go-api -o jsonpath={.status.conditions[?(@.type==\"Ready\")].status}": {
      "out": "True"
    }
  },
  "http": {
    "prometheus/api/v1/query?query=max%28externalsecret_status_condition%7Bname%3D%22go-api-secret%22%2Ccondition%3D%22Ready%22%2Cstatus%3D%22True%22%7D%29": {
      "status": 200,
      "body": "{\"status\":\"success\",\"data\":{\"resultType\":\"vector\",\"result\":[]}}"
    }
  },
  "results": {
    "consumer-mounted": true,
    "consumers-running": true,
    "eso-controller-ready": true,
    "eso-reports-synced": false,
    "externalsecret-ready": true
  }
}
